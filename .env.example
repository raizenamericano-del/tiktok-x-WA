# ============================================================================
# KyyPureStatus v4 — Environment Variables  (by KyyDevv)
# Copy jadi .env lalu isi sesuai kebutuhan. Di Railway: isi di tab Variables.
# ============================================================================

# ---- Server ----
PORT=3000
NODE_ENV=production
# Direktori data persistent (session Baileys, uploads, history, video)
# Di Railway: mount volume lalu set DATA_DIR=/data
# (kalau volume di-mount, RAILWAY_VOLUME_MOUNT_PATH otomatis dipakai)
DATA_DIR=./data
# Proteksi akses web (opsional). Kalau diisi, app minta "App Key" dulu.
APP_KEY=

# ---- Batas ukuran ----
MAX_UPLOAD_MB=100
# Batas ukuran output. WA video message aman sampai ~64 MB; 50 MB = aman.
MAX_OUTPUT_MB=50
# Info limit Status (dipakai UI buat rekomendasi)
STATUS_MAX_MB=16
STATUS_MAX_SEC=30

# ---- Mesin video (PureHD Engine v4) ----
# Kosongkan kalau mau pakai ffmpeg-static bawaan npm
# (di Docker image ffmpeg sistem dipakai: /usr/bin/ffmpeg)
FFMPEG_PATH=
# Preset x264 per mode encode
#   turbo    = veryfast (paling cepat)
#   balanced = medium   (default, kualitas tinggi)
#   max      = slow     (2-pass, paling rapi)
FFMPEG_PRESET_FAST=veryfast
FFMPEG_PRESET=medium
FFMPEG_PRESET_SLOW=slow
# Thread ffmpeg (kosongkan = otomatis, maks 12)
FFMPEG_THREADS=
# Normalisasi loudness audio (EBU R128 -16 LUFS) biar suara rata
AUDIO_NORMALIZE=true
# Mode encode default: turbo | balanced | max
ENGINE_MODE=balanced
# Otomatis potong 30 detik (limit Status) — bisa diubah user di UI
AUTO_TRIM_STATUS=false

# ---- WhatsApp / Baileys ----
# Nama perangkat yang muncul di "Perangkat Tertaut"
WA_BROWSER=ubuntu
WA_BROWSER_NAME=KyyPureStatus
# Masa berlaku pairing code (WhatsApp ±2 menit)
PAIRING_TTL_MS=120000
QR_TIMEOUT_MS=60000
CONNECT_TIMEOUT_MS=60000
KEEP_ALIVE_MS=25000

# ---- Penyimpanan riwayat ----
KEEP_VIDEOS=12
MAX_HISTORY=40

# ---- Mode uji (JANGAN aktifkan di produksi) ----
MOCK_SEND=false

# ---------------------------------------------------------------------------
# Resource / RAM
# ---------------------------------------------------------------------------
# Video besar (2K/4K, 120fps, HEVC) butuh RAM lumayan saat di-encode.
# Engine otomatis deteksi limit RAM container:
#   LOW_MEM=auto  → hemat kalau RAM container ≤ 1200 MB (default)
#   LOW_MEM=on    → paksa mode hemat (target 720p, lookahead 15, 2 thread)
#   LOW_MEM=off   → paksa kualitas maksimal (butuh RAM ≥ 1.5 GB)
LOW_MEM=auto

# Jumlah thread ffmpeg. Makin banyak = makin cepat TAPI makin boros RAM.
# Container kecil (0.5–1 GB): pakai 1 atau 2.
FFMPEG_THREADS=2

# ---------------------------------------------------------------------------
# Mode TikTok (v4.2)
# ---------------------------------------------------------------------------
# Batas ukuran file hasil mode TikTok (MB). Default 280 = aman buat upload dari
# app HP (iOS ~287 MB) sekaligus cukup buat bitrate 8-12 Mbps di video panjang.
# Naikkan kalau upload lewat web/desktop (limit web sampai 4 GB).
TT_MAX_OUTPUT_MB=280

# Level log server: debug | info | warn | error | silent
# (log selalu ke stderr supaya stdout tetap bersih buat CLI --json)
LOG_LEVEL=info
